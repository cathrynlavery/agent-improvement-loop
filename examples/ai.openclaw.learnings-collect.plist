<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.learnings-collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOU/.local/share/agent-improvement-loop/scripts/collect_learnings_fleet.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/learnings-collect.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/learnings-collect.launchd.log</string>
</dict>
</plist>
